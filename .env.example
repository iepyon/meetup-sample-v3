# docker-compose.yml がプロジェクトルートの .env を自動ロードして変数展開する。
# このファイルを `.env` にコピーして値を上書きする（.env は .gitignore 済み）。
#   cp .env.example .env
# ラッパー (scripts/docker-dev.sh) が export する変数（MOUNT_ROOT / WORK_DIR 等）は
# ここで設定不要。以下は任意の上書き用。

# 非 root ユーザーの UID/GID（bind mount の所有権整合。macOS 既定: 501 / 20）
# USER_UID=501
# USER_GID=20

# ホスト公開ポート（コンテナ内は常に backend=3000 / frontend=5173 固定）
# BACKEND_PORT=3000
# FRONTEND_PORT=5173

# JWT 署名鍵。開発用ダミー。★本番環境では絶対に流用しないこと★
# 未設定なら compose 既定値 "docker-dev-secret" が使われる。
# JWT_SECRET=docker-dev-secret

# コンテナ内 Claude Code 用（WITH_CLAUDE=1 でマウントした場合のみ利用）。
# 設定すると `docker inspect` から平文で見える点に留意。
# ANTHROPIC_API_KEY=
