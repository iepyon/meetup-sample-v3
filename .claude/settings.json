{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(./scripts/docker-dev.sh test:*)",
      "Bash(./scripts/docker-dev.sh lint:*)",
      "Bash(./scripts/docker-dev.sh typecheck:*)",
      "Bash(./scripts/docker-dev.sh review:*)",
      "Bash(./scripts/docker-dev.sh e2e:*)",
      "Bash(./scripts/docker-dev.sh up:*)",
      "Bash(./scripts/docker-dev.sh dev:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "WebFetch",
      "WebSearch"
    ],
    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-leak-detector.sh\"",
            "timeout": 10,
            "statusMessage": "機密情報スキャン中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-format.sh\"",
            "timeout": 15,
            "statusMessage": "Prettier フォーマット中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/dep-install-guard.sh\"",
            "timeout": 10,
            "statusMessage": "依存パッケージチェック中..."
          }
        ]
      }
    ]
  },
  "channelsEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
